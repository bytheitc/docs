# Copy to .env.local (never commit .env.local).
PORT=4011
# This service's public address. The DSNs it hands out point here (e.g. https://errors.bytheitc.xyz).
PUBLIC_URL=http://localhost:4011

# Its own database. Prefer a separate cluster from what it watches.
MONGODB_URI=
ERRORS_DB_NAME=itc_errors

# Staff sign in with CMS accounts that have the "errors" space.
CMS_API_URL=http://localhost:4100
# Leave empty in development: the CMS accepts "dev-errors-key" for a space with no key configured.
CMS_SPACE_KEY=

# Events kept per issue, and for how long. Issues and their daily counts outlive the events.
RETENTION_DAYS=30
EVENTS_PER_ISSUE=100
# Events accepted per project per minute; the rest get 429 and the SDK backs off.
PROJECT_RATE_PER_MIN=600

# Alerts on a new issue or a regression. A Slack or Discord incoming-webhook URL works as is.
ALERT_WEBHOOK_URL=
# And/or email, sent through the email house (email/api POST /transactional).
ALERT_EMAIL_TO=
EMAIL_API_URL=
EMAIL_SERVICE_KEY=
ALERT_COOLDOWN_MINUTES=60

# This service's own errors: logs by default. Don't point ERROR_DSN at this service itself.
ERROR_REPORTING=logs
# Only if this service should report to a *different* tracker (e.g. GlitchTip watching this one).
ERROR_DSN=
RELEASE=
LOG_FORMAT=
# Shared rate-limit counters (see http.ts). Unset TRUST_PROXY = on under Vercel, off elsewhere.
RATE_LIMIT_DB_NAME=itc_ratelimit
TRUST_PROXY=
API_LOG=
