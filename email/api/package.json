{
  "name": "itc-email-api",
  "version": "1.0.0",
  "private": true,
  "description": "ITC email campaigns: recipient lists with dynamic fields, Markdown templates, and sends through a pluggable mail provider.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@vercel/functions": "3.10.6",
    "express": "5.3.0",
    "mongodb": "7.8.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
