# Copy to .env.local (never commit .env.local).
# This api holds the house's CMS key (staff sign-in only — no public content), its own database
# credentials, and the mail provider's key. None of it ever reaches a browser.

PORT=4010

# The CMS service (cms/api) — used only so staff can sign in with their existing CMS account.
CMS_API_URL=http://localhost:4100
# This house's space key, from itc/.env.space-keys (CMS_SPACE_KEY_EMAIL).
# Leave empty in development: the CMS also accepts "dev-email-key" for a space with no key configured.
CMS_SPACE_KEY=

# This api's own public address. The mail provider posts bounces and complaints to
# <API_PUBLIC_URL>/webhooks/resend (or /postmark), so in production it must be public https.
API_PUBLIC_URL=http://localhost:4010

# email/web, for the unsubscribe link and other links in sent mail.
WEB_URL=http://localhost:3009

# ---- This service's own data ------------------------------------------------
# The cluster connection string (itc/.env.cluster). Only this api connects to it.
MONGODB_URI=
EMAIL_DB_NAME=itc_email
EMAIL_DB=mongodb

# ---- Sending ------------------------------------------------------------------
#   log (default) | resend | postmark | none
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=ITC <hello@example.org>
MAIL_REPLY_TO=
# Postmark only: the stream campaign mail goes on. Bulk mail must not share the transactional
# "outbound" stream. Create a Broadcast stream in Postmark and put its id here.
POSTMARK_BROADCAST_STREAM=broadcast
# Authenticates bounce/complaint webhooks. Resend: the endpoint's "whsec_…" signing secret.
# Postmark: a long random string, used as the Basic-auth password in the webhook URL.
MAIL_WEBHOOK_SECRET=

# ---- Transactional mail for other houses (POST /transactional) ----------------
# house:key pairs, comma-separated; each key at least 24 characters. Give each house only its own.
#   EMAIL_SERVICE_KEYS=portal:<key>,accounts:<key>
EMAIL_SERVICE_KEYS=

# Pause between messages in a campaign send, in ms. 600ms default keeps you under 2/sec.
SEND_DELAY_MS=600

# Set to "off" to skip schema registration on boot, or to silence request logs.
REGISTER_SCHEMA=
API_LOG=

# Seconds to hold a content response in memory. Default 60.
CONTENT_TTL=60

# ---- Scheduled work on serverless hosts ------------------------------------
# Vercel Cron calls /cron/* (schedules in vercel.json) with "Authorization: Bearer <CRON_SECRET>".
# Set it on the Vercel project and Vercel sends it automatically. Unset = the /cron routes are off.
# On a serverless host (VERCEL=1) the in-process timers default to off and these routes take over.
CRON_SECRET=
# Seconds one invocation may keep sending a campaign before handing it back to the next cron run.
# Default 240 on a serverless host (Vercel kills a function at 300), no limit elsewhere.
SEND_BUDGET_SECONDS=

# ---- Rate limits -----------------------------------------------------------
# Counted in MongoDB (MONGODB_URI above), shared by every instance; memory only when it is unset.
# The database the shared counters live in, one for every service.
RATE_LIMIT_DB_NAME=itc_ratelimit
# Whether to read the client address from X-Forwarded-For: "on", "off" or a hop count.
# Unset: on under Vercel (it overwrites the header, so it can't be spoofed), off elsewhere.
TRUST_PROXY=

# ---- Logs and error reporting (observe.ts) ---------------------------------
# json (default in production) | text
LOG_FORMAT=
# glitchtip | logs. "glitchtip" sends unhandled errors to ERROR_DSN (GlitchTip, Sentry or errors/api
# all accept it); "logs" keeps them in the log only. Default: glitchtip when ERROR_DSN is set.
ERROR_REPORTING=
ERROR_DSN=
# Tag reports with this release. Default: the Vercel git commit.
RELEASE=
