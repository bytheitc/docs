# Copy to .env.local (never commit .env.local).

# Database for the native admin. Supported: mongodb
CMS_DB=mongodb
# MongoDB connection string, e.g. from MongoDB Atlas. All six apps can share one cluster.
MONGODB_URI=
# Optional; defaults to itc_portal
CMS_DB_NAME=

# Required in production to create the first admin account at /admin/login.
# Use a long random value and remove it once the first admin exists.
CMS_SETUP_TOKEN=

# Public URLs of the other properties (used by the shared footer).
NEXT_PUBLIC_ITC_SITE_URL=
NEXT_PUBLIC_ITC_AI_URL=
NEXT_PUBLIC_ITC_ENGINEERING_URL=
NEXT_PUBLIC_ITC_INSTITUTE_URL=
NEXT_PUBLIC_ITC_OSS_URL=
NEXT_PUBLIC_ITC_RESEARCH_URL=
NEXT_PUBLIC_ITC_PORTAL_URL=

# ---------------------------------------------------------------------------
# Contributor portal
# ---------------------------------------------------------------------------
# Public URL of this portal, used for OAuth callback URLs. Required in production.
# In development it defaults to the request origin (http://localhost:3006).
PORTAL_URL=

# Sign-in providers. A provider appears on /sign-in only when its client id AND secret are set.
# Every callback URL is <PORTAL_URL>/auth/<provider>/callback, e.g. http://localhost:3006/auth/github/callback in dev.
# Identity-only scopes are requested; access tokens are used once to read the profile and never stored.

# GitHub OAuth App (Settings → Developer settings → OAuth Apps). No scopes requested.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Org-level, read-only token for syncing PRs/issues in tracked orgs/repos (fine-grained PAT or GitHub App installation token).
GITHUB_SYNC_TOKEN=
# Optional: token with Issues read/write on tracked repos, so claims assign the issue on GitHub.
# Without it, claims are recorded and a notice goes to the admin inbox.
GITHUB_ISSUES_TOKEN=

# GitLab application (scope: read_user). GITLAB_BASE_URL for self-managed instances (default https://gitlab.com).
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
GITLAB_BASE_URL=
# Optional group access token (read_api) for private projects.
GITLAB_SYNC_TOKEN=

# Codeberg or any Forgejo/Gitea instance. CODEBERG_BASE_URL for self-hosted Forgejo (default https://codeberg.org).
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
CODEBERG_BASE_URL=
CODEBERG_SYNC_TOKEN=

# Hugging Face OAuth app (scopes: openid profile). Optional read token for private org repos.
HF_CLIENT_ID=
HF_CLIENT_SECRET=
HF_SYNC_TOKEN=

# ORCID public API client (scope /authenticate). Works are read from the public API; no sync token needed.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# Set to 1 to use sandbox.orcid.org.
ORCID_SANDBOX=

# Wikimedia OAuth 2 consumer registered on meta.wikimedia.org (identity only). Edits come from the public API.
WIKIMEDIA_CLIENT_ID=
WIKIMEDIA_CLIENT_SECRET=

# Crowdin OAuth app. Sync needs a project manager's token (projects + reports). CROWDIN_API_URL for Crowdin Enterprise.
CROWDIN_CLIENT_ID=
CROWDIN_CLIENT_SECRET=
CROWDIN_SYNC_TOKEN=
CROWDIN_API_URL=

# Development only: a "dev" sign-in provider exists whenever NODE_ENV is not "production" (next dev).
# It needs no variables and cannot be enabled in a production build.
