# Copy to .env.local (never commit .env.local).
# This api holds the house's CMS key. It never reaches a browser.

PORT=4006

# The CMS service (cms/api).
CMS_API_URL=http://localhost:4100
# This house's space key, from itc/.env.space-keys (CMS_SPACE_KEY_PORTAL).
# Leave empty in development: the CMS also accepts "dev-portal-key" for a space with no key configured.
CMS_SPACE_KEY=

# This api's own address, as the CMS sees it. The CMS posts content webhooks to <API_PUBLIC_URL>/cms/webhook.
API_PUBLIC_URL=http://localhost:4006

# This house's web (portal/web), and the secret it expects on POST /api/revalidate.
WEB_URL=http://localhost:3006
REVALIDATE_SECRET=

# Seconds to hold a content response in memory. Default 60.
CONTENT_TTL=60
# Set to "off" to skip schema registration on boot, or to silence request logs.
REGISTER_SCHEMA=
API_LOG=

# ---- The portal's own data -------------------------------------------------
# The cluster connection string (itc/.env.cluster). Only this api connects to it.
MONGODB_URI=
PORTAL_DB_NAME=itc_portal
PORTAL_DB=mongodb

# ---- Platform providers ----------------------------------------------------
# One OAuth client per platform people may sign in with. Unset providers simply don't appear.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
HUGGINGFACE_CLIENT_ID=
HUGGINGFACE_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
WIKIMEDIA_CLIENT_ID=
WIKIMEDIA_CLIENT_SECRET=
CROWDIN_CLIENT_ID=
CROWDIN_CLIENT_SECRET=
# Optional: a token with issue write access, so claiming an issue assigns it automatically.
GITHUB_TOKEN=
