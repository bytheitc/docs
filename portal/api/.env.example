# Copy to .env.local (never commit .env.local).
# This api holds the house's CMS key. It never reaches a browser.

PORT=4006

# The CMS service (cms/api).
CMS_API_URL=http://localhost:4100
# This house's space key, from itc/.env.space-keys (CMS_SPACE_KEY_PORTAL).
# Leave empty in development: the CMS also accepts "dev-portal-key" for a space with no key configured.
CMS_SPACE_KEY=

# This api's own address, as the CMS sees it. The CMS posts content webhooks to <API_PUBLIC_URL>/cms/webhook.
API_PUBLIC_URL=http://localhost:4006

# This house's web (portal/web), and the secret it expects on POST /api/revalidate.
WEB_URL=http://localhost:3006
REVALIDATE_SECRET=

# Seconds to hold a content response in memory. Default 60.
CONTENT_TTL=60
# Set to "off" to skip schema registration on boot, or to silence request logs.
REGISTER_SCHEMA=
API_LOG=

# ---- The portal's own data -------------------------------------------------
# The cluster connection string (itc/.env.cluster). Only this api connects to it.
MONGODB_URI=
PORTAL_DB_NAME=itc_portal
PORTAL_DB=mongodb

# ---- accounts/api ("Sign in with ITC") -------------------------------------
# The only other service allowed to read a contributor, and only this one field at a time:
# GET /internal/contributors/:id. Shared with accounts/api's own ACCOUNTS_SERVICE_KEY.
# Leave empty in development: this api also accepts "dev-accounts-service-key" when none is set.
ACCOUNTS_SERVICE_KEY=

# ---- Platform providers ----------------------------------------------------
# One OAuth client per platform people may sign in with. Unset providers simply don't appear.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
CODEBERG_CLIENT_ID=
CODEBERG_CLIENT_SECRET=
HF_CLIENT_ID=
HF_CLIENT_SECRET=
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
WIKIMEDIA_CLIENT_ID=
WIKIMEDIA_CLIENT_SECRET=
CROWDIN_CLIENT_ID=
CROWDIN_CLIENT_SECRET=
# Optional: a token with Issues read and write on the bytheitc repositories. With it, claiming an issue
# assigns it on GitHub, and the portal comments on the issue when someone claims, asks, or is approved
# or declined. The comments appear as whoever owns the token.
# Without it a claim still works; it lands in the CMS inbox for a steward to assign by hand.
GITHUB_ISSUES_TOKEN=
# Optional: a token used when syncing, to raise GitHub's rate limit. The First Hundred board uses it
# too: without it GitHub allows 10 searches a minute, shared with everything on the same address.
GITHUB_SYNC_TOKEN=
# The GitHub organisation whose issues labelled first-hundred make up the launch board.
FIRST_HUNDRED_ORG=bytheitc
# Optional sync tokens for the other platforms (private repos, higher rate limits).
GITLAB_SYNC_TOKEN=
CODEBERG_SYNC_TOKEN=
HF_SYNC_TOKEN=
CROWDIN_SYNC_TOKEN=
# Self-hosted instances. Defaults: https://gitlab.com, https://codeberg.org, the Crowdin v2 api.
GITLAB_BASE_URL=
CODEBERG_BASE_URL=
CROWDIN_API_URL=
# "1" signs people in against sandbox.orcid.org instead of orcid.org (testing only).
ORCID_SANDBOX=

# ---- Transactional email (F6) ----------------------------------------------
# log (default, prints to the server log and sends nothing) | none | resend | postmark
MAIL_PROVIDER=log
# The provider's API key. Never commit it.
MAIL_API_KEY=
MAIL_FROM=ITC <hello@example.org>
MAIL_REPLY_TO=

# ---- Work this api does on its own clock -----------------------------------
# One instance should run these; set both to 0 on any other.
# How often to release claims past their date. 0 switches it off.
CLAIM_SWEEP_MINUTES=15
# How often to sync every active source. 0 (the default) means only staff can start a sync.
SYNC_INTERVAL_MINUTES=0
# How often to carry nominations whose seven days are up, and move maintainers inactive for six
# months to emeritus. Both rules come from the Open Source governance page. 0 switches it off.
GOVERNANCE_SWEEP_MINUTES=60

# ---- Property URLs ---------------------------------------------------------
# Read by src/content/houses.ts, the house list this api serves in its seed content. Set them to
# the same public URLs the webs use, or seed content links to localhost.
NEXT_PUBLIC_ITC_SITE_URL=
NEXT_PUBLIC_ITC_AI_URL=
NEXT_PUBLIC_ITC_ENGINEERING_URL=
NEXT_PUBLIC_ITC_HEALTH_URL=
NEXT_PUBLIC_ITC_INSTITUTE_URL=
NEXT_PUBLIC_ITC_OSS_URL=
NEXT_PUBLIC_ITC_RESEARCH_URL=
NEXT_PUBLIC_ITC_PORTAL_URL=

# ---- Scheduled work on serverless hosts ------------------------------------
# Vercel Cron calls /cron/* (schedules in vercel.json) with "Authorization: Bearer <CRON_SECRET>".
# Set it on the Vercel project and Vercel sends it automatically. Unset = the /cron routes are off.
# On a serverless host (VERCEL=1) the in-process timers default to off and these routes take over.
CRON_SECRET=

# ---- Rate limits -----------------------------------------------------------
# Counted in MongoDB (MONGODB_URI above), shared by every instance; memory only when it is unset.
# The database the shared counters live in, one for every service.
RATE_LIMIT_DB_NAME=itc_ratelimit
# Whether to read the client address from X-Forwarded-For: "on", "off" or a hop count.
# Unset: on under Vercel (it overwrites the header, so it can't be spoofed), off elsewhere.
TRUST_PROXY=

# ---- Logs and error reporting (observe.ts) ---------------------------------
# json (default in production) | text
LOG_FORMAT=
# glitchtip | logs. "glitchtip" sends unhandled errors to ERROR_DSN (GlitchTip, Sentry or errors/api
# all accept it); "logs" keeps them in the log only. Default: glitchtip when ERROR_DSN is set.
ERROR_REPORTING=
ERROR_DSN=
# Tag reports with this release. Default: the Vercel git commit.
RELEASE=
