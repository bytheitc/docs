# Copy to .env.local (never commit .env.local).
# A web holds no database settings and no service credentials: it talks only to its own api.

# This house's api (portal/api).
API_URL=http://localhost:4006
# Shared with portal/api. The api calls POST /api/revalidate with it after the CMS reports a change.
REVALIDATE_SECRET=

# The Studio (cms/web), where the portal's content is edited. The staff tools link into it.
NEXT_PUBLIC_CMS_WEB_URL=http://localhost:3100

# Public URLs of the other properties (used by the shared footer).
NEXT_PUBLIC_ITC_SITE_URL=
NEXT_PUBLIC_ITC_AI_URL=
NEXT_PUBLIC_ITC_ENGINEERING_URL=
NEXT_PUBLIC_ITC_INSTITUTE_URL=
NEXT_PUBLIC_ITC_OSS_URL=
NEXT_PUBLIC_ITC_RESEARCH_URL=
NEXT_PUBLIC_ITC_PORTAL_URL=
