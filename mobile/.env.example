# Copy to .env (Expo reads EXPO_PUBLIC_* at bundle time; they end up in the app binary, so never
# put a secret here). Leave both empty in development to use the local defaults in src/lib/api.ts.

# portal/api, which this app talks to and nothing else.
EXPO_PUBLIC_PORTAL_API_URL=
# portal/web, for links that open in the browser.
EXPO_PUBLIC_PORTAL_WEB_URL=
