# Copy to .env.local (never commit .env.local).
PORT=4012
# This service's public address. The script tag every site loads points here (e.g. https://analytics.bytheitc.xyz).
PUBLIC_URL=http://localhost:4012

# Its own database.
MONGODB_URI=
ANALYTICS_DB_NAME=itc_analytics

# Staff sign in with CMS accounts that have the "analytics" space.
CMS_API_URL=http://localhost:4100
# Leave empty in development: the CMS accepts "dev-analytics-key" for a space with no key configured.
CMS_SPACE_KEY=

# How long individual page views are kept (400 days, so a year can be compared with the last).
RETENTION_DAYS=400
# Events accepted per visitor address per minute; the rest get 429.
COLLECT_RATE_PER_MIN=120

# This service's own errors (observe.ts): "logs", or "glitchtip" with ERROR_DSN from errors/api.
ERROR_REPORTING=logs
ERROR_DSN=
RELEASE=
LOG_FORMAT=
# Shared rate-limit counters (see http.ts). Must be on behind a proxy, or every visitor looks like
# the proxy: one visitor, and one shared rate limit. Unset = on under Vercel, off elsewhere.
RATE_LIMIT_DB_NAME=itc_ratelimit
TRUST_PROXY=
API_LOG=
