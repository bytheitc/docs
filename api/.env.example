# Copy to .env.local (never commit .env.local). Nothing here ever reaches a browser.

PORT=4013

# The CMS (cms/api), used only so staff sign in to the editor with their existing CMS account.
CMS_API_URL=http://localhost:4100
# This house's space key (CMS_SPACE_KEY_DOCS). Leave empty in development: the CMS also accepts
# "dev-docs-key" for a space with no key configured.
CMS_SPACE_KEY=

API_PUBLIC_URL=http://localhost:4013
# docs/web, told to refresh after every edit.
WEB_URL=http://localhost:3011
# Shared with docs/web (its REVALIDATE_SECRET).
REVALIDATE_SECRET=

# ---- Where the pages live --------------------------------------------------
# github | fs. Default: github when DOCS_GITHUB_TOKEN is set, otherwise fs (../content, for development).
DOCS_SOURCE=
DOCS_GITHUB_REPO=bytheitc/docs
DOCS_GITHUB_BRANCH=main
# The folder in that repository holding the pages.
DOCS_GITHUB_PATH=content
# A fine-grained personal access token with "Contents: Read and write" on bytheitc/docs only.
# Every save in the editor becomes a commit made with it, authored by the staff member who saved.
DOCS_GITHUB_TOKEN=
# The folder the fs source uses. Default: ../content.
DOCS_CONTENT_DIR=
# Seconds a read of the repository is reused before GitHub is asked again.
CONTENT_TTL=60

# ---- Rate limits -----------------------------------------------------------
# Counted in MongoDB when it's set, shared by every instance; memory only when it is unset.
MONGODB_URI=
RATE_LIMIT_DB_NAME=itc_ratelimit

# ---- Logs and error reporting (observe.ts) ---------------------------------
LOG_FORMAT=
ERROR_REPORTING=
ERROR_DSN=
RELEASE=
