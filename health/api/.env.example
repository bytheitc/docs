# Copy to .env.local (never commit .env.local).
# This api holds the house's CMS key. It never reaches a browser.

PORT=4007

# The CMS service (cms/api).
CMS_API_URL=http://localhost:4100
# This house's space key, from itc/.env.space-keys (CMS_SPACE_KEY_HEALTH).
# Leave empty in development: the CMS also accepts "dev-health-key" for a space with no key configured.
CMS_SPACE_KEY=

# This api's own address, as the CMS sees it. The CMS posts content webhooks to <API_PUBLIC_URL>/cms/webhook.
API_PUBLIC_URL=http://localhost:4007

# This house's web (research/web), and the secret it expects on POST /api/revalidate.
WEB_URL=http://localhost:3007
REVALIDATE_SECRET=

# Seconds to hold a content response in memory. Default 60.
CONTENT_TTL=60
# Set to "off" to skip schema registration on boot, or to silence request logs.
REGISTER_SCHEMA=
API_LOG=

# ---- Property URLs ---------------------------------------------------------
# Read by src/content/houses.ts, the house list this api serves in its seed content. Set them to
# the same public URLs the webs use, or seed content links to localhost.
NEXT_PUBLIC_ITC_SITE_URL=
NEXT_PUBLIC_ITC_AI_URL=
NEXT_PUBLIC_ITC_ENGINEERING_URL=
NEXT_PUBLIC_ITC_HEALTH_URL=
NEXT_PUBLIC_ITC_INSTITUTE_URL=
NEXT_PUBLIC_ITC_OSS_URL=
NEXT_PUBLIC_ITC_RESEARCH_URL=
NEXT_PUBLIC_ITC_PORTAL_URL=

# ---- Rate limits -----------------------------------------------------------
# Optional for this api, but needed in production on Vercel: rate limits are counted in MongoDB
# when this is set, and only in each instance's memory when it isn't (no real limit on serverless).
# The cluster connection string (itc/.env.cluster).
MONGODB_URI=
# The database the shared counters live in, one for every service.
RATE_LIMIT_DB_NAME=itc_ratelimit
# Whether to read the client address from X-Forwarded-For: "on", "off" or a hop count.
# Unset: on under Vercel (it overwrites the header, so it can't be spoofed), off elsewhere.
TRUST_PROXY=

# ---- Logs and error reporting (observe.ts) ---------------------------------
# json (default in production) | text
LOG_FORMAT=
# glitchtip | logs. "glitchtip" sends unhandled errors to ERROR_DSN (GlitchTip, Sentry or errors/api
# all accept it); "logs" keeps them in the log only. Default: glitchtip when ERROR_DSN is set.
ERROR_REPORTING=
ERROR_DSN=
# Tag reports with this release. Default: the Vercel git commit.
RELEASE=
