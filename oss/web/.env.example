# Copy to .env.local (never commit .env.local).
# A web holds no database settings and no service credentials: it talks only to its own api.

# This house's api (oss/api).
API_URL=http://localhost:4004
# Shared with oss/api. The api calls POST /api/revalidate with it after the CMS reports a change.
REVALIDATE_SECRET=

# ---- "Sign in with ITC" --------------------------------------------------
# accounts/api's address, and the client_id this site registered for itself at /developers on it
# (public client — this is a traditional web app with a server-side callback, so PKCE alone is
# enough; there's no secret to hold). Self-service only covers openid/profile; anything more
# would need a staff reviewer there first.
ACCOUNTS_API_URL=http://localhost:4009
ACCOUNTS_CLIENT_ID=

# Public URLs of the other properties (used by the shared footer).
NEXT_PUBLIC_ITC_SITE_URL=
NEXT_PUBLIC_ITC_AI_URL=
NEXT_PUBLIC_ITC_ENGINEERING_URL=
NEXT_PUBLIC_ITC_INSTITUTE_URL=
NEXT_PUBLIC_ITC_OSS_URL=
NEXT_PUBLIC_ITC_RESEARCH_URL=
NEXT_PUBLIC_ITC_PORTAL_URL=
