{
  "name": "itc-oss-api",
  "version": "1.0.0",
  "private": true,
  "description": "Open Source at ITC: registers its content schema with the CMS, serves content to oss/web and reads the contributor wall from portal/api.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "^24.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
