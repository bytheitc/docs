# Copy to .env.local (never commit .env.local).
# A web holds no database settings and no service credentials: it talks only to its own api.

# This house's api (engineering/api).
API_URL=http://localhost:4002
# Shared with engineering/api. The api calls POST /api/revalidate with it after the CMS reports a change.
REVALIDATE_SECRET=

# Public URLs of every property. NEXT_PUBLIC_* values are baked in when `next build` runs, so they
# must be set in the build environment, not only at runtime. This house's own URL is also its
# canonical address (metadataBase, robots.txt, sitemap.xml).
NEXT_PUBLIC_ITC_SITE_URL=
NEXT_PUBLIC_ITC_AI_URL=
NEXT_PUBLIC_ITC_ENGINEERING_URL=
NEXT_PUBLIC_ITC_HEALTH_URL=
NEXT_PUBLIC_ITC_INSTITUTE_URL=
NEXT_PUBLIC_ITC_OSS_URL=
NEXT_PUBLIC_ITC_RESEARCH_URL=
NEXT_PUBLIC_ITC_PORTAL_URL=

# Analytics (analytics/api), baked in at build time. Both empty = no tracking script.
# The site id comes from the analytics Sites page, or `npm run site` in analytics/api.
NEXT_PUBLIC_ANALYTICS_URL=
NEXT_PUBLIC_ANALYTICS_SITE=
