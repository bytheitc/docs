# Copy to .env.local (never commit .env.local).

PORT=4008

# This service's OWN database. It must not be the database of anything it watches: a status page
# that dies alongside its subject is worse than no status page at all. A separate cluster is better
# than a separate database on the same one.
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority
STATUS_DB_NAME=itc_status

# This service's public address. Used in the embed snippet, the badge and the JSON feed, so it has
# to be the address other people will reach, not localhost, once this is deployed.
PUBLIC_URL=http://localhost:4008

# Which tenant to serve when the Host header matches no tenant. Handy in development, where every
# request arrives as localhost. Leave empty in production so an unknown host gets a plain 404.
ROOT_TENANT=

# How often each service is probed, and how long individual probes are kept. The daily roll-ups
# keep the long history, so this only governs the "right now" reading.
CHECK_INTERVAL_SECONDS=60
PRUNE_DAYS=14

# Creates the first tenant, once, and returns its admin token. Unset it afterwards: while it is
# set, anyone who knows it can add a tenant to this deployment.
SETUP_TOKEN=

# "on" behind a load balancer, so the Host header is read correctly.
TRUST_PROXY=
# "off" silences request logs.
API_LOG=

# Signs unsubscribe links, so every notification can carry one that never expires and needs no
# sign-in. Any long random string. Without it, subscriptions stay switched off entirely: a default
# secret would be worse than no feature, because anyone could forge an unsubscribe link.
#   openssl rand -base64 48
SUBSCRIBE_SECRET=

# Email. "log" prints messages to the server log and sends nothing, which is the development
# default and makes the confirmation link clickable without a provider. See src/mail.ts.
MAIL_PROVIDER=log
MAIL_API_KEY=
MAIL_FROM=Status <no-reply@example.org>
MAIL_REPLY_TO=

# Subscribe attempts allowed per IP per 10 minutes. The default is fine for a public page.
SUBSCRIBE_LIMIT=10
