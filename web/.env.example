# Copy to .env.local (never commit .env.local).
# docs/api, server-side only.
API_URL=http://localhost:4013
# Shared with docs/api, which calls /api/revalidate after every edit.
REVALIDATE_SECRET=
# Seconds a page is cached before docs/api is asked again (edits also drop it at once).
CONTENT_TTL=60
# This site's public address, for links in metadata and the sitemap.
# Default: https://docs.bytheitc.xyz
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_ITC_PORTAL_URL=http://localhost:3006
