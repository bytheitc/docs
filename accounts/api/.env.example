# Copy to .env.local (never commit .env.local).
# This api holds the house's CMS key, the key portal/api requires on its internal endpoint, and the
# id_token signing key. None of it ever reaches a browser.

PORT=4009

# The CMS service (cms/api). This space holds only the collective's own trusted ("first-party")
# OAuth clients — a partner's app never goes through the CMS, it registers itself.
CMS_API_URL=http://localhost:4100
# This house's space key, from itc/.env.space-keys (CMS_SPACE_KEY_ACCOUNTS).
# Leave empty in development: the CMS also accepts "dev-accounts-key" for a space with no key configured.
CMS_SPACE_KEY=

# This api's own address, as the CMS sees it. The CMS posts content webhooks to <API_PUBLIC_URL>/cms/webhook.
API_PUBLIC_URL=http://localhost:4009

# accounts/web, and the secret it expects on POST /api/revalidate.
WEB_URL=http://localhost:3008
REVALIDATE_SECRET=

# ---- This service's own data ------------------------------------------------
# The cluster connection string (itc/.env.cluster). Only this api connects to it.
MONGODB_URI=
ACCOUNTS_DB_NAME=itc_accounts
ACCOUNTS_DB=mongodb

# ---- portal/api: the only place an ITC account is created --------------------
# Signup stays entirely portal's. This api proxies its existing /auth/* federated login and, for
# ongoing identity claims, calls one small internal endpoint it exposes just for this service.
PORTAL_API_URL=http://localhost:4006
PORTAL_WEB_URL=http://localhost:3006
# Shared with portal/api's ACCOUNTS_SERVICE_KEY. Leave empty in development: portal/api also
# accepts "dev-accounts-service-key" when none is configured.
ACCOUNTS_SERVICE_KEY=

# ---- "Sign in with ITC" id_token -----------------------------------------------
# PKCS#8 PEM, required in production (an ephemeral key in development invalidates every id_token on
# restart). Generate with: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
OAUTH_SIGNING_KEY=

# Seconds to hold a content response in memory. Default 60.
CONTENT_TTL=60
# Set to "off" to skip schema registration on boot, or to silence request logs.
REGISTER_SCHEMA=
API_LOG=
