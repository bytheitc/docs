PORT=4100
# Which database: mongodb (the only one supported so far).
CMS_DB=mongodb
MONGODB_URI=mongodb+srv://user:pass@cluster.example.mongodb.net/?retryWrites=true&w=majority
CMS_DB_NAME=itc_cms
# One key per space, comma-separated: "<space>:<long random key>". Each house api gets its own as CMS_SPACE_KEY.
# In development (NODE_ENV !== "production") a space with no key here also accepts "dev-<space>-key".
CMS_SPACE_KEYS=site:change-me-site-key,ai:change-me-ai-key
# Required to create the first admin in production.
CMS_SETUP_TOKEN=change-me-setup-token
# Set to 1 (or a hop count) behind a reverse proxy so sign-in rate limits see client addresses.
CMS_TRUST_PROXY=
# Sign-in/setup attempts per 10 minutes per client and email.
CMS_LOGIN_LIMIT=20
# "off" silences request logs.
CMS_LOG=

# ---- Transactional email (F6) ----------------------------------------------
# log (default, prints to the server log and sends nothing) | none | resend | postmark
MAIL_PROVIDER=log
# The provider's API key. Never commit it.
MAIL_API_KEY=
MAIL_FROM=ITC <hello@example.org>
MAIL_REPLY_TO=

# ---- Rate limits -----------------------------------------------------------
# Counted in MongoDB (MONGODB_URI above), shared by every instance; memory only when it is unset.
# The database the shared counters live in, one for every service.
RATE_LIMIT_DB_NAME=itc_ratelimit

# ---- Logs and error reporting (observe.ts) ---------------------------------
# json (default in production) | text
LOG_FORMAT=
# glitchtip | logs. "glitchtip" sends unhandled errors to ERROR_DSN (GlitchTip, Sentry or errors/api
# all accept it); "logs" keeps them in the log only. Default: glitchtip when ERROR_DSN is set.
ERROR_REPORTING=
ERROR_DSN=
# Tag reports with this release. Default: the Vercel git commit.
RELEASE=
